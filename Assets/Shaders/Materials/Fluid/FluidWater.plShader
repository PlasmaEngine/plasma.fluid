[MATERIALPARAMETER]

Permutation BLEND_MODE;
Permutation SHADING_MODE;
Permutation TWO_SIDED;
Permutation FORWARD_PASS_WRITE_DEPTH;
Permutation WATER_USE_REFRACTION @Default(true);
Permutation WATER_USE_FOAM @Default(true);
Permutation WATER_USE_SUBSURFACE @Default(true);

// The simulated surface of plasma.fluid's Water volumes: height, flow, foam.
float FluidHeightScale @Default(1.0) @Group("Fluid");
float FluidNormalStrength @Default(1.0) @Clamp(0.0, 1.0);
float FluidFoamStrength @Default(1.0);
// Caps the displacement in metres, downward and upward. 0 or less is no cap.
float FluidMaxDisplacement @Default(30.0);

// A Gerstner swell over the whole surface, inside and outside the simulated area, so the two join without a seam.
float WaveAmplitude @Default(0.18) @Group("Swell");
float WaveLength @Default(14.0);
float WaveDirection @Default(30.0);
float WaveSpread @Default(0.7) @Clamp(0.0, 1.5);
float WaveChoppiness @Default(0.7) @Clamp(0.0, 1.0);
float WaveSpeed @Default(1.0);
// Share of the swell a strong current tears down, where the water runs 4 m/s or faster.
float WaveFlowDamping @Default(0.6) @Clamp(0.0, 1.0);

// Breaking waves. The surface is a height field and cannot fold over, so the crest of a front is pushed forward over
// its own face, by how far the water falls away ahead of it: the lip leans out and the face shears under it.
// Metres ahead the fall is measured over, and how far the crest is pushed per metre of fall.
float CurlReach @Default(1.0) @Group("Breaking");
float CurlAmount @Default(0.6);
// Whitewater on the face of a front, where the water runs down it.
float FaceFoam @Default(1.0);

// Ripples of the normal map. On open water they drift with the current; around a vortex they are mapped around the
// funnel and down its wall at their true size and turn with the water.
bool UseNormalTexture @Default(true) @Group("Ripples");
Texture2D NormalTexture;
float NormalStrength @Default(0.35);
// Metres per tile of the normal map.
float NormalScale @Default(3.0);
float FlowCycle @Default(1.2);
// Farthest the pattern drifts per cycle on open water, in tiles, however fast the current.
float FlowMaxTravel @Default(0.35);
float DetailFadeDistance @Default(120.0);

// The water is a medium: along every view ray under the surface light is absorbed (per channel, so deep water turns
// blue-green) and scattered toward the camera from the sun, the sky and every light in or near the water.
// Absorption per metre, per channel.
Color AbsorptionColor @Default(Color(0.45, 0.075, 0.06, 1.0)) @Group("Water");
float AbsorptionScale @Default(1.0);
// Colour of the light the water scatters, and how much it scatters per metre.
Color ScatterColor @Default(Color(0.35, 1.0, 0.9, 1.0));
float ScatterDensity @Default(0.12);
// 0 scatters evenly in all directions; toward 1 light keeps going the way it travelled, so the water glows most
// looking toward a light.
float ScatterAnisotropy @Default(0.35) @Clamp(0.0, 0.95);
// Farthest the scattering is integrated below the surface, metres.
float VolumeDistance @Default(30.0);
float DepthFadeDistance @Default(0.25);
// Water this far below rest level sees little of the sky: the throat of a whirlpool goes dark.
float CavityDepth @Default(8.0);
float CavityStrength @Default(0.6) @Clamp(0.0, 1.0);

float Roughness @Default(0.08) @Clamp(0.0, 1.0) @Group("Surface");
float RoughnessFar @Default(0.2) @Clamp(0.0, 1.0);
float SpecularIntensity @Default(1.0);

float RefractionStrength @Default(0.35) @Group("Refraction");
float CausticsStrength @Default(1.6);
float CausticsScale @Default(1.6);
float CausticsSpeed @Default(1.0);
float CausticsFade @Default(0.35);

Texture2D FoamTexture @Group("Foam");
Color FoamColor @Default(Color(0.92, 0.95, 0.97, 1.0));
// Metres per tile of the foam texture.
float FoamScale @Default(4.0);
// Around a vortex, foam tiles are this many times longer along the flow than across it: streaks.
float FoamStreak @Default(4.0);
// Around a vortex, how far the streaks lean inward, degrees: they spiral into the funnel.
float FoamSpiral @Default(20.0);
float FoamSoftness @Default(0.12);
// Most of the surface foam covers, however much foam the simulation holds.
float FoamMaxCoverage @Default(0.6) @Clamp(0.0, 1.0);
float CrestFoam @Default(0.6);
float IntersectionFoamWidth @Default(0.5);
// Faint foam lace everywhere, strongest on open water.
float LaceStrength @Default(0.2);



[RENDERSTATE]
#include <Shaders/Materials/MaterialState.h>

DepthBias = 2
SlopeScaledDepthBias = 1.0

// The water writes depth in the forward pass even though it blends: it is nearly opaque (the refraction composites
// what is behind it), and depth is what sorts a surface that folds over itself, like a whirlpool's funnel, and what
// lets fog, particles and later transparent passes see the water.
#if defined(RENDER_PASS) && RENDER_PASS == RENDER_PASS_FORWARD
DepthWrite = true
#endif

